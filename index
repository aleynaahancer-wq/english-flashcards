<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>English Flashcards</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f5f5f7;
      color: #222;
      min-height: 100vh;
    }

    .container {
      width: 100%;
      max-width: 600px;
      margin: auto;
      padding: 25px 15px 50px;
    }

    h1 {
      text-align: center;
      margin-bottom: 5px;
    }

    .subtitle {
      text-align: center;
      color: #777;
      margin-bottom: 25px;
    }

    .filters {
      display: flex;
      gap: 8px;
      justify-content: center;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }

    button {
      border: none;
      border-radius: 12px;
      padding: 11px 18px;
      cursor: pointer;
      font-size: 15px;
    }

    .filter-btn {
      background: white;
      border: 1px solid #ddd;
    }

    .filter-btn.active {
      background: #222;
      color: white;
    }

    .card {
      background: white;
      min-height: 330px;
      border-radius: 22px;
      padding: 35px 25px;
      box-shadow: 0 8px 30px rgba(0,0,0,0.08);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
    }

    .type {
      font-size: 13px;
      background: #eeeeee;
      border-radius: 20px;
      padding: 6px 12px;
      margin-bottom: 20px;
    }

    .word {
      font-size: 42px;
      font-weight: bold;
      margin-bottom: 12px;
    }

    .past {
      font-size: 18px;
      color: #666;
      margin-bottom: 15px;
    }

    .turkish {
      font-size: 25px;
      margin-bottom: 25px;
    }

    .example {
      font-size: 17px;
      line-height: 1.5;
      color: #555;
    }

    .hidden {
      display: none;
    }

    .show-btn {
      width: 100%;
      margin-top: 18px;
      background: #222;
      color: white;
    }

    .navigation {
      display: flex;
      gap: 10px;
      margin-top: 15px;
    }

    .navigation button {
      flex: 1;
      background: white;
      border: 1px solid #ddd;
    }

    .counter {
      margin-top: 15px;
      text-align: center;
      color: #777;
      font-size: 14px;
    }

    @media (max-width: 500px) {
      .container {
        padding-top: 15px;
      }

      h1 {
        font-size: 26px;
      }

      .card {
        min-height: 310px;
        padding: 25px 18px;
      }

      .word {
        font-size: 36px;
      }

      .turkish {
        font-size: 22px;
      }
    }
  </style>
</head>

<body>

<div class="container">

  <h1>English Flashcards</h1>
  <div class="subtitle">Kelimeyi öğren ✨</div>

  <div class="filters">
    <button class="filter-btn active" onclick="filterCards('all', this)">
      Hepsi
    </button>

    <button class="filter-btn" onclick="filterCards('verb', this)">
      Fiiller
    </button>

    <button class="filter-btn" onclick="filterCards('other', this)">
      Diğer
    </button>
  </div>

  <div class="card">

    <div id="type" class="type"></div>

    <div id="word" class="word"></div>

    <div id="past" class="past"></div>

    <div id="answer" class="hidden">
      <div id="turkish" class="turkish"></div>
      <div id="example" class="example"></div>
    </div>

  </div>

  <button class="show-btn" onclick="showAnswer()">
    Cevabı Göster
  </button>

  <div class="navigation">

    <button onclick="previousCard()">
      ← Önceki
    </button>

    <button onclick="randomCard()">
      🎲 Rastgele
    </button>

    <button onclick="nextCard()">
      Sonraki →
    </button>

  </div>

  <div id="counter" class="counter"></div>

</div>

<script>

const words = [

  {
    word: "take",
    turkish: "almak / götürmek",
    type: "verb",
    past: "took",
    example: "I take the bus to school."
  },

  {
    word: "give",
    turkish: "vermek",
    type: "verb",
    past: "gave",
    example: "She gave me a present."
  },

  {
    word: "buy",
    turkish: "satın almak",
    type: "verb",
    past: "bought",
    example: "I bought a new bag yesterday."
  },

  {
    word: "teach",
    turkish: "öğretmek",
    type: "verb",
    past: "taught",
    example: "She taught English last year."
  },

  {
    word: "find",
    turkish: "bulmak",
    type: "verb",
    past: "found",
    example: "I found my keys."
  },

  {
    word: "meet",
    turkish: "tanışmak / buluşmak",
    type: "verb",
    past: "met",
    example: "I met my friends yesterday."
  },

  {
    word: "leave",
    turkish: "ayrılmak / terk etmek",
    type: "verb",
    past: "left",
    example: "He left the house early."
  },

  {
    word: "bring",
    turkish: "getirmek",
    type: "verb",
    past: "brought",
    example: "Please bring your book."
  },

  {
    word: "put",
    turkish: "koymak",
    type: "verb",
    past: "put",
    example: "Put the phone on the table."
  },

  {
    word: "look after",
    turkish: "ilgilenmek / bakmak",
    type: "verb",
    past: "looked after",
    example: "She looks after her little brother."
  },

  {
    word: "look for",
    turkish: "aramak",
    type: "verb",
    past: "looked for",
    example: "I am looking for my keys."
  },

  {
    word: "get up",
    turkish: "kalkmak",
    type: "verb",
    past: "got up",
    example: "I get up at seven every morning."
  },

  {
    word: "borrow",
    turkish: "ödünç almak",
    type: "verb",
    past: "borrowed",
    example: "Can I borrow your pen?"
  },

  {
    word: "arrive",
    turkish: "varmak / ulaşmak",
    type: "verb",
    past: "arrived",
    example: "We arrived at the hotel at eight."
  },

  {
    word: "better",
    turkish: "daha iyi",
    type: "other",
    example: "This book is better than that one."
  },

  {
    word: "worse",
    turkish: "daha kötü",
    type: "other",
    example: "The weather is worse today."
  },

  {
    word: "a few",
    turkish: "birkaç / az sayıda",
    type: "other",
    example: "I have a few friends in Istanbul."
  },

  {
    word: "a little",
    turkish: "biraz",
    type: "other",
    example: "There is a little milk in the fridge."
  },

  {
    word: "some",
    turkish: "biraz / bazı",
    type: "other",
    example: "I need some water."
  },

  {
    word: "most of",
    turkish: "çoğu",
    type: "other",
    example: "Most of the students passed the exam."
  },

  {
    word: "expensive",
    turkish: "pahalı",
    type: "other",
    example: "This restaurant is very expensive."
  },

  {
    word: "cheap",
    turkish: "ucuz",
    type: "other",
    example: "These shoes are cheap."
  },

  {
    word: "tall",
    turkish: "uzun boylu",
    type: "other",
    example: "My brother is very tall."
  }

];

let filteredWords = words;
let currentIndex = 0;

function displayCard() {

  if (filteredWords.length === 0) {
    return;
  }

  const current = filteredWords[currentIndex];

  document.getElementById("word").textContent =
    current.word;

  document.getElementById("turkish").textContent =
    current.turkish;

  document.getElementById("type").textContent =
    current.type === "verb"
      ? "FİİL"
      : "KELİME / İFADE";

  document.getElementById("past").textContent =
    current.type === "verb"
      ? "V2: " + current.past
      : "";

  document.getElementById("example").textContent =
    current.example;

  document.getElementById("answer")
    .classList.add("hidden");

  document.getElementById("counter").textContent =
    (currentIndex + 1) +
    " / " +
    filteredWords.length;
}

function showAnswer() {

  document.getElementById("answer")
    .classList.toggle("hidden");
}

function nextCard() {

  currentIndex++;

  if (currentIndex >= filteredWords.length) {
    currentIndex = 0;
  }

  displayCard();
}

function previousCard() {

  currentIndex--;

  if (currentIndex < 0) {
    currentIndex = filteredWords.length - 1;
  }

  displayCard();
}

function randomCard() {

  currentIndex =
    Math.floor(Math.random() * filteredWords.length);

  displayCard();
}

function filterCards(type, button) {

  document
    .querySelectorAll(".filter-btn")
    .forEach(btn => btn.classList.remove("active"));

  button.classList.add("active");

  if (type === "all") {
    filteredWords = words;
  } else {
    filteredWords =
      words.filter(item => item.type === type);
  }

  currentIndex = 0;
  displayCard();
}

displayCard();

</script>

</body>
</html>
